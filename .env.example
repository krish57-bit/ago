# Ago configuration. Copy to .env and fill in the two keys below.

# --- Language model: choose ONE of the two options ---

# Option A (default): Anthropic. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Option B: any OpenAI-compatible API, including free tiers.
# Example: Google Gemini (free key at https://aistudio.google.com/api-keys)
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MODEL=gemini-3.5-flash,gemini-flash-lite-latest   # comma = fallback chain (free tiers have per-model daily quotas)
# REASONING_EFFORT=low                              # optional: much faster on Gemini; leave unset for other providers
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   MODEL=llama-3.3-70b-versatile
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Web search (required): https://tavily.com, free tier is enough ---
TAVILY_API_KEY=

# --- Optional ---
# MODEL=claude-sonnet-5-5          # Anthropic default; claude-haiku-5-5 is faster and cheaper
# PORT=3000
# DEFAULT_TIMEZONE=Asia/Kolkata    # fallback when the browser does not report one
# DATA_DIR=data                    # where memory.jsonl lives
# RATE_LIMIT_PER_MIN=20            # chat requests per client per minute (0 = off)
# LOG_LEVEL=info                   # "silent" to mute
# LOG_FORMAT=pretty                # "json" for structured logs
# SEARCH_PROVIDER=tavily           # or "mock" to run without a search key
# ALLOW_CLOCK_OVERRIDE=1           # lets a client send {now} to simulate the date (for evals)
